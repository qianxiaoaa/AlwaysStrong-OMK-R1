# AlwaysStrong + TEESimulator-RS SELinux policy.
#
# Keystore data files: the attestation engine reads the target list / patch level
# out of /data/adb/tricky_store, which is not a keystore-owned path.
allow keystore {adb_data_file shell_data_file} file *

# TEESimulator-RS injects into keystore2 from the crash_dump domain (it uses
# crash_dump's ptrace capability to write the intercepting library in). Without
# this the injection is denied and keystore2 serves the system backend.
allow crash_dump keystore process *
